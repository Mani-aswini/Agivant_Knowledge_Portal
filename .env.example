# ===================================================================
# Environment Configuration Template for Knowledge Portal
# ===================================================================
# Copy this file to '.env' or set environment variables in your operating system.
# DO NOT commit actual secrets or production passwords to source control.

# Database Configuration (MySQL Server)
DB_URL=jdbc:mysql://localhost:3306/knowledge_portal_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# Server Port
SERVER_PORT=8080

# Upload Storage Path
UPLOAD_DIR=./uploads

# AI Agent Configuration
# Optional: Set your OpenAI or compatible API key to enable REAL_AI mode.
# If omitted or empty, the application automatically runs in deterministic SIMULATION mode.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL_NAME=gpt-4o-mini
